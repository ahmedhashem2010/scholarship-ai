generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum user_role {
  STUDENT
  PARENT
  COUNSELOR
  UNIVERSITY_STAFF
  PROVIDER_STAFF
  ADMIN
  SUPER_ADMIN
}

enum account_status {
  PENDING
  ACTIVE
  SUSPENDED
  DISABLED
  DELETED
}

enum provider_type {
  GOVERNMENT
  UNIVERSITY
  CORPORATE
  NON_PROFIT
  PRIVATE_FOUNDATION
  INTERNATIONAL_ORGANIZATION
  PHILANTHROPIC
  OTHER
}

enum scholarship_status {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  INACTIVE
  ARCHIVED
  REJECTED
  MERGED
}

enum verification_status {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
  NEEDS_REVIEW
}

enum funding_type {
  FULLY_FUNDED
  PARTIALLY_FUNDED
  SELF_FUNDED
  LOAN
  WORK_STUDY
  UNKNOWN
}

enum competition_level {
  LOW
  MEDIUM
  HIGH
  VERY_HIGH
}

enum cycle_status {
  UPCOMING
  OPEN
  CLOSED
  COMPLETED
  CANCELLED
  POSTPONED
}

enum content_status {
  DRAFT
  PUBLISHED
  SCHEDULED
  ARCHIVED
  REJECTED
}

enum import_status {
  PENDING
  PROCESSING
  COMPLETED
  PARTIAL
  FAILED
  CANCELLED
}

enum import_source_type {
  MANUAL
  CSV
  JSON
  API
  SCRAPER
  AI_EXTRACTION
  BULK_UPDATE
}

enum queue_item_status {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  SKIPPED
  DUPLICATE
}

enum change_type {
  CREATE
  UPDATE
  MERGE
  DELETE
  STATUS_CHANGE
  VERIFICATION_CHANGE
}

enum duplicate_status {
  OPEN
  FALSE_POSITIVE
  MERGED
  KEEP_BOTH
  RESOLVED
}

enum verification_priority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum ai_provider {
  GROQ
  GEMINI
  OPENAI
  CLAUDE
  BAZAARLINK
  AGENTROUTER
  OTHER
}

model Continent {
  id        String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code      String     @unique @db.VarChar(2)
  name      String     @db.VarChar(100)
  nameAr    String?    @map("name_ar") @db.VarChar(100)
  slug      String     @unique @db.VarChar(120)
  sortOrder Int        @default(0) @map("sort_order")
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt DateTime?  @map("deleted_at") @db.Timestamptz

  countries Country[]

  @@map("continents")
}

model Currency {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code         String   @unique @db.VarChar(3)
  name         String   @db.VarChar(100)
  nameAr       String?  @map("name_ar") @db.VarChar(100)
  symbol       String?  @db.VarChar(10)
  decimalPlaces Int     @default(2) @map("decimal_places")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  countries Country[]

  @@map("currencies")
}

model Language {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code       String   @unique @db.VarChar(10)
  name       String   @db.VarChar(100)
  nameAr     String?  @map("name_ar") @db.VarChar(100)
  nativeName String?  @map("native_name") @db.VarChar(100)
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@map("languages")
}

model Country {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  continentId String  @map("continent_id") @db.Uuid
  code       String   @unique @db.VarChar(2)
  code3      String?  @db.VarChar(3)
  name       String   @db.VarChar(120)
  nameAr     String?  @map("name_ar") @db.VarChar(120)
  slug       String   @unique @db.VarChar(140)
  phoneCode  String?  @map("phone_code") @db.VarChar(10)
  currencyId String?  @map("currency_id") @db.Uuid
  isActive   Boolean  @default(true) @map("is_active")
  flagUrl    String?  @map("flag_url") @db.VarChar(500)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz

  continent Continent @relation(fields: [continentId], references: [id])
  currency  Currency? @relation(fields: [currencyId], references: [id])

  universities University[]
  scholarships Scholarship[]

  @@map("countries")
}

model DegreeLevel {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @db.VarChar(100)
  nameAr    String?  @map("name_ar") @db.VarChar(100)
  slug      String   @unique @db.VarChar(120)
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  scholarships Scholarship[]

  @@map("degree_levels")
}

model StudyField {
  id        String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  parentId  String?     @map("parent_id") @db.Uuid
  name      String      @db.VarChar(200)
  nameAr    String?     @map("name_ar") @db.VarChar(200)
  slug      String      @unique @db.VarChar(220)
  sortOrder Int         @default(0) @map("sort_order")
  isActive  Boolean     @default(true) @map("is_active")
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  parent    StudyField? @relation("field_parent", fields: [parentId], references: [id])
  children  StudyField[] @relation("field_parent")
  scholarships Scholarship[]

  @@map("study_fields")
}

model User {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email         String   @db.VarChar(320)
  phone         String?  @db.VarChar(40)
  displayName   String   @map("display_name") @db.VarChar(120)
  role          user_role @default(STUDENT)
  accountStatus account_status @default(PENDING) @map("account_status")
  avatarUrl     String?  @map("avatar_url") @db.VarChar(500)
  countryId     String?  @map("country_id") @db.Uuid
  cityId        String?  @map("city_id") @db.Uuid
  timezone      String   @default("UTC") @db.VarChar(64)
  locale        String   @default("ar") @db.VarChar(10)
  languageId    String?  @map("language_id") @db.Uuid
  referralCode  String?  @unique @map("referral_code") @db.VarChar(40)
  referredBy    String?  @map("referred_by") @db.Uuid
  emailVerified Boolean  @default(false) @map("email_verified")
  isTestAccount Boolean  @default(false) @map("is_test_account")
  lastLoginAt   DateTime? @map("last_login_at") @db.Timestamptz
  metadata      Json     @default("{}")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz

  @@map("users")
}

model University {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name               String   @db.VarChar(200)
  nameAr             String?  @map("name_ar") @db.VarChar(200)
  slug               String   @unique @db.VarChar(220)
  countryId          String   @map("country_id") @db.Uuid
  cityId             String?  @map("city_id") @db.Uuid
  website            String?  @db.VarChar(300)
  description        String?
  descriptionAr      String?  @map("description_ar")
  logoUrl            String?  @map("logo_url") @db.VarChar(500)
  coverUrl           String?  @map("cover_url") @db.VarChar(500)
  establishedYear    Int?     @map("established_year")
  rankingNational    Int?     @map("ranking_national")
  rankingWorld       Int?     @map("ranking_world")
  isPublic           Boolean? @map("is_public")
  isFeatured         Boolean  @default(false) @map("is_featured")
  status             content_status @default(DRAFT)
  verificationStatus verification_status @default(UNVERIFIED) @map("verification_status")
  verifiedAt         DateTime? @map("verified_at") @db.Timestamptz
  verifiedBy         String?  @map("verified_by") @db.Uuid
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt          DateTime? @map("deleted_at") @db.Timestamptz

  country Country @relation(fields: [countryId], references: [id])

  scholarships Scholarship[]

  @@map("universities")
}

model Provider {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name               String   @db.VarChar(200)
  nameAr             String?  @map("name_ar") @db.VarChar(200)
  slug               String   @unique @db.VarChar(220)
  providerType       provider_type @default(OTHER) @map("provider_type")
  countryId          String?  @map("country_id") @db.Uuid
  website            String?  @db.VarChar(300)
  logoUrl            String?  @map("logo_url") @db.VarChar(500)
  description        String?
  contactEmail       String?  @map("contact_email") @db.VarChar(320)
  contactPhone       String?  @map("contact_phone") @db.VarChar(40)
  isVerified         Boolean  @default(false) @map("is_verified")
  verificationStatus verification_status @default(UNVERIFIED) @map("verification_status")
  status             content_status @default(DRAFT)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz

  scholarships Scholarship[]

  @@map("providers")
}

model Source {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String   @db.VarChar(200)
  baseUrl          String?  @map("base_url") @db.VarChar(500)
  sourceType       import_source_type @default(SCRAPER) @map("source_type")
  countryId        String?  @map("country_id") @db.Uuid
  providerId       String?  @map("provider_id") @db.Uuid
  crawlerFrequency String?  @map("crawler_frequency") @db.VarChar(30)
  lastScrapedAt    DateTime? @map("last_scraped_at") @db.Timestamptz
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  batches ImportBatch[]
  scholarships Scholarship[]

  @@map("sources")
}

