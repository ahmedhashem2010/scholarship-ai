{
  "name": "smartscholar-backend",
  "version": "1.0.0",
  "private": true,
  "description": "SmartScholar backend - PostgreSQL schema (SQL-owned), Prisma mirror, operational scripts and docs",
  "scripts": {
    "seed": "tsx scripts/seed.ts",
    "import:scholarships": "tsx scripts/importScholarships.ts",
    "sync:deadlines": "tsx scripts/syncDeadlines.ts",
    "embeddings": "tsx scripts/generateEmbeddings.ts",
    "detect:duplicates": "tsx scripts/detectDuplicates.ts",
    "update:scholarships": "tsx scripts/updateScholarships.ts",
    "verify:scholarships": "tsx scripts/verifyScholarships.ts",
    "db:generate": "prisma generate",
    "typecheck": "tsc --noEmit",
    "acquire": "tsx src/acquisition/cli.ts",
    "acquire:daad": "tsx src/acquisition/cli.ts --providers daad",
    "acquire:erasmus": "tsx src/acquisition/cli.ts --providers erasmus",
    "acquire:chevening": "tsx src/acquisition/cli.ts --providers chevening",
    "acquire:fulbright": "tsx src/acquisition/cli.ts --providers fulbright",
    "acquire:mext": "tsx src/acquisition/cli.ts --providers mext",
    "acquire:stipendium-hungaricum": "tsx src/acquisition/cli.ts --providers stipendium-hungaricum",
    "acquire:csc": "tsx src/acquisition/cli.ts --providers csc",
    "test": "tsx src/acquisition/run-tests.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.1.0",
    "cheerio": "^1.2.0",
    "pdf-parse": "^2.4.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "prisma": "^6.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
