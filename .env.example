# =============================================================================
# SmartScholar — environment variables
# Copy to `.env` and fill in. NEVER commit `.env`.
# Vars marked [REQUIRED] must be set or the app will not work correctly.
# =============================================================================

# --- Database ---------------------------------------------------------------
# [REQUIRED] Runtime queries. TRANSACTION pooler, port 6543.
# postgresql://USER:PASS@aws-1-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=no-verify
DATABASE_URL=

# [REQUIRED] Schema migrations only. SESSION pooler, port 5432, NO pgbouncer flag.
# Same credentials as DATABASE_URL — only the port and query string differ.
# postgresql://USER:PASS@aws-1-<region>.pooler.supabase.com:5432/postgres?sslmode=no-verify
#
# Why both: `prisma db push` and `prisma migrate` run ALTER TABLE / CREATE INDEX,
# which the transaction pooler (6543) cannot handle. Without DIRECT_URL those
# commands connect and then hang forever with no error message.
DIRECT_URL=

# --- Supabase Auth ----------------------------------------------------------
# NOTE: Auth and Database are two SEPARATE Supabase projects. These point at
# the AUTH project, not the database one.
# [REQUIRED]
NEXT_PUBLIC_SUPABASE_URL=
# [REQUIRED]
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# [REQUIRED] Full admin over auth. Server-side only — never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# --- Email (Zoho Mail over SMTP) ---------------------------------------------
# Verify the whole chain with:  node scripts/test-email.mjs you@gmail.com
#
# [REQUIRED] Region-specific. An account created on zoho.com uses smtp.zoho.com;
# zoho.eu uses smtp.zoho.eu; zoho.in uses smtp.zoho.in. The wrong host fails
# authentication with a misleading error.
SMTP_HOST=smtp.zoho.com
# 465 = implicit TLS (recommended). 587 = STARTTLS. Do not mix them up.
SMTP_PORT=465
# [REQUIRED] The full mailbox address, not just the local part.
SMTP_USER=care@smartscholar.org
# [REQUIRED] If two-factor auth is on — and it should be — your normal password
# will NOT work here. Generate an app-specific password:
#   Zoho Account -> Security -> App Passwords
SMTP_PASSWORD=
# [REQUIRED] Must be the authenticated mailbox or a verified alias of it.
# Zoho rejects anything else outright rather than silently rewriting it.
EMAIL_FROM="SmartScholar <care@smartscholar.org>"
# Where replies land. Students do reply to these — keep it a mailbox you read.
EMAIL_REPLY_TO=care@smartscholar.org

# --- AI provider -------------------------------------------------------------
# SmartScholar does NOT call AgentRouter directly. All AI reviews go to the
# isolated review service on Railway, which owns the AgentRouter API key.
# There is no fallback chain — if this fails, the review surfaces an error
# instead of switching providers.
# Verify with:  node scripts/test-ai.mjs
#
# [REQUIRED] Base URL of the Railway AI review service. It must expose
# POST {AI_REVIEW_SERVICE_URL}/review accepting { documentType, text } and
# returning the ReviewScore JSON (or { error, message } with a mapped status).
# The AgentRouter key is NOT part of SmartScholar — it lives only in Railway.
AI_REVIEW_SERVICE_URL=
# [REQUIRED] Model requested through the AgentRouter gateway (metadata only —
# recorded on the Review record; the prompt and the request are built in
# Railway). claude-opus-4-8 is the verified default (live-tested through
# AgentRouter). If the Railway group returns HTTP 503 "无可用渠道" (no available
# channel) for it, switch to a model that group serves.
AGENTROUTER_MODEL=claude-opus-4-8
# Optional timeout (ms) for the review-service request. Default 60000.
# AI_REVIEW_TIMEOUT_MS=60000
# Set to "true" to log review-service requests/responses. Keep OFF in
# production: request bodies contain fragments of user-uploaded documents.
AI_DEBUG=false

# --- Admin ------------------------------------------------------------------
# Optional. The ONLY email allowed to reach the admin user-list endpoint
# (/api/users), enforced in src/app/api/users/route.ts. If unset, that route
# returns 500.
ADMIN_EMAIL=

# --- Site -------------------------------------------------------------------
# [REQUIRED FOR LAUNCH] Canonical public URL, no trailing slash. Used for email
# links, OG tags and sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Analytics --------------------------------------------------------------
# Optional. GA4 measurement ID, e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=
# Optional. Microsoft Clarity project ID (8 hex chars), e.g. xxxxxxxx
# https://clarity.microsoft.com -> Project Settings -> Project ID
NEXT_PUBLIC_CLARITY_ID=

# --- Scheduled jobs ---------------------------------------------------------
# [REQUIRED for reminders] Shared secret for /api/cron/reminders.
# Without it that endpoint refuses to run — otherwise anyone on the internet
# could trigger email to your users. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=
