# Database
# SQLite (local dev) — use this in development
# DATABASE_URL="file:./dev.db"
#
# PostgreSQL (production) — use this when deploying.
# IMPORTANT: Before deploying, replace prisma/schema.prisma with prisma/schema.postgres.prisma
# Then run: npx prisma generate && npx prisma migrate deploy
DATABASE_URL="file:./dev.db"

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AgentRouter (Claude Sonnet via AgentRouter API)
AGENTROUTER_API_KEY=

# Admin
ADMIN_EMAIL=ahmed_m_hashem@outlook.com

# Google Analytics (set this when you have a measurement ID)
NEXT_PUBLIC_GA_ID=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
