generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                String             @id
  email             String?            @unique
  name              String?
  reviewCredits     Int                @default(0)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  applications      Application[]
  documents         Document[]
  payments          Payment[]
  reviews           Review[]
  roadmapMilestones RoadmapMilestone[]
  profile           UserProfile?
}

model UserProfile {
  id                 String    @id @default(cuid())
  userId             String    @unique
  displayName        String
  dateOfBirth        DateTime
  country            String
  educationLevel     String
  major              String?
  targetDegree       String
  englishLevel       String
  englishScore       Int?
  gpa                Float?
  hasWorkExperience  Boolean   @default(false)
  workYears          Int?
  hasResearch        Boolean   @default(false)
  budget             String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  englishTestDate    DateTime?
  englishTestType    String?
  gpaScale           String?
  graduationYear     Int?
  hasEnglishTest     String?
  nationality        String?
  preferredCountries String[]
  testTimeframe      String?
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Scholarship {
  id                  String             @id @default(cuid())
  nameEn              String             @unique
  nameAr              String
  country             String
  university          String?
  degree              String
  deadline            DateTime?
  flagUrl             String?
  description         String?
  benefits            String?
  requirements        String?
  sourceUrl           String?
  source              String?
  eligibleCountries   String[]
  eligibleEducation   String[]
  fieldOfStudy        String[]
  minimumAge          Int?
  maximumAge          Int?
  minimumGPA          Float?
  englishRequirement  String?
  requiresResearch    Boolean            @default(false)
  requiresWorkExp     Boolean            @default(false)
  applicationFee      Float?
  competitionLevel    String             @default("medium")
  requiredDocuments   String[]
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  applicationOpenDate DateTime?
  deadlineType        String?            @default("UNKNOWN")
  inactiveReason      String?
  isActive            Boolean            @default(true)
  isVerified          Boolean            @default(false)
  recurrenceNote      String?
  verifiedAt          DateTime?
  applications        Application[]
  roadmapMilestones   RoadmapMilestone[]

  @@index([isActive, deadline])
  @@index([country])
}

model Application {
  id            String                @id @default(cuid())
  userId        String
  scholarshipId String
  status        String                @default("NOT_STARTED")
  progress      Int                   @default(0)
  startedAt     DateTime              @default(now())
  submittedAt   DateTime?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  scholarship   Scholarship           @relation(fields: [scholarshipId], references: [id])
  user          User                  @relation(fields: [userId], references: [id])
  documents     ApplicationDocument[]

  @@unique([userId, scholarshipId])
  @@index([userId])
  @@index([scholarshipId])
}

model Payment {
  id              String    @id @default(cuid())
  userId          String
  amount          Int
  credits         Int
  status          String    @default("pending")
  createdAt       DateTime  @default(now())
  method          String    @default("stripe")
  packageId       String?
  receiptUrl      String?
  reference       String?
  rejectionReason String?
  reviewedAt      DateTime?
  reviewedBy      String?
  stripeEventId   String?   @unique
  stripeSessionId String?
  updatedAt       DateTime  @default(now()) @updatedAt
  userNote        String?
  user            User      @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status, createdAt])
}

model ReferralCode {
  id        String   @id @default(cuid())
  code      String   @unique
  credits   Int
  maxUses   Int
  usedCount Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Document {
  id               String                @id @default(cuid())
  userId           String
  fileName         String
  fileUrl          String
  fileType         String
  fileSize         Int
  documentType     String                @default("OTHER")
  version          Int                   @default(1)
  parentDocumentId String?
  improvementScore Float?
  uploadedAt       DateTime              @default(now())
  appDocuments     ApplicationDocument[]
  parentDocument   Document?             @relation("DocumentVersions", fields: [parentDocumentId], references: [id])
  childVersions    Document[]            @relation("DocumentVersions")
  user             User                  @relation(fields: [userId], references: [id])
  reviews          Review[]

  @@index([userId])
}

model ApplicationDocument {
  id                 String      @id @default(cuid())
  applicationId      String
  documentType       String
  status             String      @default("NOT_STARTED")
  aiScore            Int?
  uploadedDocumentId String?
  feedback           String?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  application        Application @relation(fields: [applicationId], references: [id])
  uploadedDocument   Document?   @relation(fields: [uploadedDocumentId], references: [id])

  @@index([applicationId])
}

model Review {
  id              String   @id @default(cuid())
  documentId      String
  userId          String
  score           Int
  strengths       String
  weaknesses      String
  suggestions     String
  grammarIssues   String
  overallFeedback String
  modelUsed       String   @default("gemini-2.0-flash")
  createdAt       DateTime @default(now())
  document        Document @relation(fields: [documentId], references: [id])
  user            User     @relation(fields: [userId], references: [id])

  @@index([documentId])
  @@index([userId])
}

/// A saved roadmap milestone.
///
/// The roadmap itself is generated deterministically from the deadline, so it
/// does NOT need storing to be displayed. What needs storing is the student's
/// relationship to it: which scholarships they're actually working on, which
/// steps they've ticked off, and whether we've already nagged them about a
/// given date. Without that, the roadmap is a pretty diagram they look at once.
///
/// Flat rather than a parent Roadmap + children: the unique constraint makes
/// "save or update this roadmap" a single upsert per milestone, and every query
/// we care about ("what's due for this user in the next 7 days") filters on
/// user + date without needing a join.
model RoadmapMilestone {
  id             String      @id @default(cuid())
  userId         String
  scholarshipId  String
  /// Matches MilestoneKey in src/lib/roadmap-generator.ts.
  key            String
  dueDate        DateTime
  isDone         Boolean     @default(false)
  doneAt         DateTime?
  /// Set when a reminder email goes out, so a re-run can't send duplicates.
  /// Nullable rather than a boolean so we keep the timestamp for debugging.
  reminderSentAt DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @default(now()) @updatedAt
  scholarship    Scholarship @relation(fields: [scholarshipId], references: [id], onDelete: Cascade)
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, scholarshipId, key])
  @@index([userId, isDone])
  @@index([dueDate, isDone, reminderSentAt])
}
