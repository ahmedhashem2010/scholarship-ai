generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                String             @id
  email             String?            @unique
  name              String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  applications      Application[]
  documents         Document[]
  reviews           Review[]
  dailyUsage        ReviewDailyUsage[]
  roadmapMilestones RoadmapMilestone[]
  profile           UserProfile?
}

model UserProfile {
  id                 String    @id @default(cuid())
  userId             String    @unique
  displayName        String
  dateOfBirth        DateTime
  country            String
  educationLevel     String
  major              String?
  targetDegree       String
  englishLevel       String
  englishScore       Int?
  gpa                Float?
  hasWorkExperience  Boolean   @default(false)
  workYears          Int?
  hasResearch        Boolean   @default(false)
  budget             String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  englishTestDate    DateTime?
  englishTestType    String?
  gpaScale           String?
  graduationYear     Int?
  hasEnglishTest     String?
  nationality        String?
  preferredCountries String[]
  testTimeframe      String?
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Scholarship {
  id                  String             @id @default(cuid())
  nameEn              String             @unique
  nameAr              String
  country             String
  university          String?
  degree              String
  deadline            DateTime?
  flagUrl             String?
  description         String?
  benefits            String?
  requirements        String?
  sourceUrl           String?
  source              String?
  // The real scholarship website / application URL, when a human has found it.
  // Kept separate from `sourceUrl` (the page where the record was found —
  // often a for9a.com listing) so the UI never presents an aggregator page as
  // the "official" one.
  officialWebsite     String?
  applicationUrl      String?
  eligibleCountries   String[]
  eligibleEducation   String[]
  fieldOfStudy        String[]
  minimumAge          Int?
  maximumAge          Int?
  minimumGPA          Float?
  englishRequirement  String?
  requiresResearch    Boolean            @default(false)
  requiresWorkExp     Boolean            @default(false)
  applicationFee      Float?
  competitionLevel    String             @default("medium")
  requiredDocuments   String[]
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  applicationOpenDate DateTime?
  deadlineType        String?            @default("UNKNOWN")
  inactiveReason      String?
  isActive            Boolean            @default(true)
  isVerified          Boolean            @default(false)
  recurrenceNote      String?
  verifiedAt          DateTime?
  applications        Application[]
  roadmapMilestones   RoadmapMilestone[]

  @@index([isActive, deadline])
  @@index([country])
}

model Application {
  id            String                @id @default(cuid())
  userId        String
  scholarshipId String
  status        String                @default("NOT_STARTED")
  progress      Int                   @default(0)
  startedAt     DateTime              @default(now())
  submittedAt   DateTime?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  scholarship   Scholarship           @relation(fields: [scholarshipId], references: [id])
  user          User                  @relation(fields: [userId], references: [id])
  documents     ApplicationDocument[]

  @@unique([userId, scholarshipId])
  @@index([userId])
  @@index([scholarshipId])
}

model Document {
  id               String                @id @default(cuid())
  userId           String
  fileName         String
  fileUrl          String
  fileType         String
  fileSize         Int
  documentType     String                @default("OTHER")
  version          Int                   @default(1)
  parentDocumentId String?
  improvementScore Float?
  uploadedAt       DateTime              @default(now())
  appDocuments     ApplicationDocument[]
  parentDocument   Document?             @relation("DocumentVersions", fields: [parentDocumentId], references: [id])
  childVersions    Document[]            @relation("DocumentVersions")
  user             User                  @relation(fields: [userId], references: [id])
  reviews          Review[]

  @@index([userId])
}

model ApplicationDocument {
  id                 String      @id @default(cuid())
  applicationId      String
  documentType       String
  status             String      @default("NOT_STARTED")
  aiScore            Int?
  uploadedDocumentId String?
  feedback           String?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  application        Application @relation(fields: [applicationId], references: [id])
  uploadedDocument   Document?   @relation(fields: [uploadedDocumentId], references: [id])

  @@index([applicationId])
}

model Review {
  id              String   @id @default(cuid())
  documentId      String
  userId          String
  score           Int
  strengths       String
  weaknesses      String
  suggestions     String
  grammarIssues   String
  overallFeedback String
  modelUsed       String   @default("gemini-2.0-flash")
  signatureRequired Boolean?
  signatureStatus   String?
  signatureNote     String?
  createdAt       DateTime @default(now())
  document        Document @relation(fields: [documentId], references: [id])
  user            User     @relation(fields: [userId], references: [id])

  @@index([documentId])
  @@index([userId])
}

/// How many AI document reviews a user has used on a given calendar day.
///
/// The free model caps reviews at DAILY_REVIEW_LIMIT per user per UTC day. The
/// count is reserved (incremented) before the AI call and released again if the
/// call fails, so a failed review never eats a user's slot. `day` is a plain
/// "YYYY-MM-DD" string keyed to UTC (see src/lib/review-quota.ts), and the
/// unique constraint makes the reserve an atomic upsert — two concurrent
/// requests can't both slip past the cap.
model ReviewDailyUsage {
  id        String   @id @default(cuid())
  userId    String
  day       String
  count     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, day])
  @@index([userId, day])
}

/// A saved roadmap milestone.
///
/// The roadmap itself is generated deterministically from the deadline, so it
/// does NOT need storing to be displayed. What needs storing is the student's
/// relationship to it: which scholarships they're actually working on, which
/// steps they've ticked off, and whether we've already nagged them about a
/// given date. Without that, the roadmap is a pretty diagram they look at once.
///
/// Flat rather than a parent Roadmap + children: the unique constraint makes
/// "save or update this roadmap" a single upsert per milestone, and every query
/// we care about ("what's due for this user in the next 7 days") filters on
/// user + date without needing a join.
model RoadmapMilestone {
  id             String      @id @default(cuid())
  userId         String
  scholarshipId  String
  /// Matches MilestoneKey in src/lib/roadmap-generator.ts.
  key            String
  dueDate        DateTime
  isDone         Boolean     @default(false)
  doneAt         DateTime?
  /// Set when a reminder email goes out, so a re-run can't send duplicates.
  /// Nullable rather than a boolean so we keep the timestamp for debugging.
  reminderSentAt DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @default(now()) @updatedAt
  scholarship    Scholarship @relation(fields: [scholarshipId], references: [id], onDelete: Cascade)
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, scholarshipId, key])
  @@index([userId, isDone])
  @@index([dueDate, isDone, reminderSentAt])
}

/// Fixed-window server-side rate-limit bucket.
///
/// Backs src/lib/rate-limit.ts for signup and verification-email resend. The
/// key embeds the scope (e.g. "signup:ip"), a hash of the value (IP or email)
/// and the UTC window start, so each window is its own row and reserving a slot
/// is a single atomic upsert on the primary key — no lost updates under
/// concurrency, and unlike the old in-memory map it is shared across every
/// Vercel instance. `windowStart` mirrors the timestamp embedded in the key so
/// expired windows can be swept by the limiter's opportunistic cleanup.
model RateLimitBucket {
  key         String   @id
  windowStart DateTime
  count       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([windowStart])
}
