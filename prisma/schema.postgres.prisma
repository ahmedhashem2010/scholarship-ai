// PostgreSQL variant — copy to schema.prisma before deploying to production.
// Run: Copy-Item prisma/schema.postgres.prisma prisma/schema.prisma
// Then: npx prisma generate && npx prisma migrate deploy

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Runtime queries go through the TRANSACTION pooler (port 6543). Fast, and
  // it survives serverless connection churn.
  url       = env("DATABASE_URL")
  // Schema changes (`prisma db push`, `migrate`) need a SESSION connection
  // (port 5432). The transaction pooler cannot run ALTER TABLE / CREATE INDEX,
  // so without this `db push` connects and then hangs forever with no error.
  directUrl = env("DIRECT_URL")
}

model User {
  id            String       @id
  email         String?  @unique
  name          String?
  profile       UserProfile?
  documents     Document[]
  reviews       Review[]
  dailyUsage    ReviewDailyUsage[]
  applications  Application[]
  roadmapMilestones RoadmapMilestone[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model UserProfile {
  id                String   @id @default(cuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName       String
  dateOfBirth       DateTime
  country           String
  educationLevel    String
  major             String?
  targetDegree      String
  englishLevel      String
  englishScore      Int?

  // --- English testing ------------------------------------------------------
  // The old single `englishLevel` select mixed proficiency (beginner…fluent)
  // with test types (IELTS, TOEFL) in one dropdown, so it couldn't answer the
  // question that actually decides eligibility: does this student HAVE a score?
  //
  // hasEnglishTest: YES | WILLING | PREFER_WITHOUT
  hasEnglishTest    String?
  // IELTS | TOEFL | DUOLINGO | PTE | CAMBRIDGE
  englishTestType   String?
  englishTestDate   DateTime?
  // <1M | 1-3M | 3-6M | 6M+
  testTimeframe     String?

  // Nationality and residence differ and both affect eligibility.
  nationality       String?
  // 4.0 | 5.0 | 100 (percentage)
  gpaScale          String?
  graduationYear    Int?
  preferredCountries String[]
  gpa               Float?
  hasWorkExperience Boolean  @default(false)
  workYears         Int?
  hasResearch       Boolean  @default(false)
  budget            String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([userId])
}

model Scholarship {
  id                  String           @id @default(cuid())
  nameEn              String           @unique
  nameAr              String
  country             String
  university          String?
  degree              String
  deadline            DateTime?
  flagUrl             String?
  description         String?
  benefits            String?
  requirements        String?
  sourceUrl           String?
  source              String?

  // Eligibility criteria — stored as JSON arrays in PostgreSQL
  eligibleCountries   String[]
  eligibleEducation   String[]
  fieldOfStudy        String[]
  minimumAge          Int?
  maximumAge          Int?
  minimumGPA          Float?
  englishRequirement  String?
  requiresResearch    Boolean          @default(false)
  requiresWorkExp     Boolean          @default(false)
  applicationFee      Float?
  competitionLevel    String           @default("medium")
  requiredDocuments   String[]

  // --- Data quality & lifecycle -------------------------------------------
  // Soft-delete. Expired scholarships and dead source links are hidden rather
  // than deleted, so we keep the record (and its SEO page) without ever showing
  // a student something they can't actually apply to.
  isActive            Boolean          @default(true)
  // Set true once a human has opened sourceUrl and confirmed the details.
  // 195 of the seeded records were scraped and have never been checked.
  isVerified          Boolean          @default(false)
  verifiedAt          DateTime?
  // Why a record was deactivated: EXPIRED | DEAD_LINK | DUPLICATE | UNVERIFIABLE
  inactiveReason      String?
  // When applications open. Needed by the roadmap generator to plan backwards
  // from the deadline without scheduling tasks before the window exists.
  applicationOpenDate DateTime?
  // FIXED | ONGOING | ANNUAL | UNKNOWN
  //
  // A null `deadline` is ambiguous on its own: it can mean the scholarship is
  // genuinely rolling ("no deadline, no application required") or that the
  // scraper simply failed to capture a real date. Those need completely
  // different messages to the student, so store which one it is.
  deadlineType        String?          @default("UNKNOWN")
  // Human-readable recurrence, e.g. "Opens annually from October 1 to May 1".
  recurrenceNote      String?

  applications        Application[]
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@index([isActive, deadline])
  @@index([country])
  roadmapMilestones RoadmapMilestone[]
}

model Application {
  id            String   @id @default(cuid())
  userId        String
  scholarshipId String
  status        String   @default("NOT_STARTED")
  progress      Int      @default(0)
  startedAt     DateTime @default(now())
  submittedAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user        User                  @relation(fields: [userId], references: [id])
  scholarship Scholarship           @relation(fields: [scholarshipId], references: [id])
  documents   ApplicationDocument[]

  @@index([userId])
  @@index([scholarshipId])
  @@unique([userId, scholarshipId])
}

model Document {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id])
  fileName         String
  fileUrl          String
  fileType         String
  fileSize         Int
  documentType     String   @default("OTHER")
  version          Int      @default(1)
  parentDocumentId String?
  parentDocument   Document?  @relation("DocumentVersions", fields: [parentDocumentId], references: [id])
  childVersions    Document[] @relation("DocumentVersions")
  improvementScore Float?
  uploadedAt       DateTime @default(now())
  reviews          Review[]
  appDocuments     ApplicationDocument[]

  @@index([userId])
}

model ApplicationDocument {
  id                 String   @id @default(cuid())
  applicationId      String
  documentType       String
  status             String   @default("NOT_STARTED")
  aiScore            Int?
  uploadedDocumentId String?
  feedback           String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  application      Application @relation(fields: [applicationId], references: [id])
  uploadedDocument Document?   @relation(fields: [uploadedDocumentId], references: [id])

  @@index([applicationId])
}

model Review {
  id             String   @id @default(cuid())
  documentId     String
  document       Document @relation(fields: [documentId], references: [id])
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  score          Int
  strengths      String
  weaknesses     String
  suggestions    String
  grammarIssues  String
  overallFeedback String
  modelUsed      String   @default("gemini-2.0-flash")
  createdAt      DateTime @default(now())

  @@index([documentId])
  @@index([userId])
}

/// How many AI document reviews a user has used on a given calendar day.
///
/// The free model caps reviews at DAILY_REVIEW_LIMIT per user per UTC day. The
/// count is reserved (incremented) before the AI call and released again if the
/// call fails, so a failed review never eats a user's slot. `day` is a plain
/// "YYYY-MM-DD" string keyed to UTC (see src/lib/review-quota.ts), and the
/// unique constraint makes the reserve an atomic upsert — two concurrent
/// requests can't both slip past the cap.
model ReviewDailyUsage {
  id        String   @id @default(cuid())
  userId    String
  day       String
  count     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, day])
  @@index([userId, day])
}

/// A saved roadmap milestone.
///
/// The roadmap itself is generated deterministically from the deadline, so it
/// does NOT need storing to be displayed. What needs storing is the student's
/// relationship to it: which scholarships they're actually working on, which
/// steps they've ticked off, and whether we've already nagged them about a
/// given date. Without that, the roadmap is a pretty diagram they look at once.
///
/// Flat rather than a parent Roadmap + children: the unique constraint makes
/// "save or update this roadmap" a single upsert per milestone, and every query
/// we care about ("what's due for this user in the next 7 days") filters on
/// user + date without needing a join.
model RoadmapMilestone {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  scholarshipId  String
  scholarship    Scholarship @relation(fields: [scholarshipId], references: [id], onDelete: Cascade)

  /// Matches MilestoneKey in src/lib/roadmap-generator.ts.
  key            String
  dueDate        DateTime
  isDone         Boolean  @default(false)
  doneAt         DateTime?

  /// Set when a reminder email goes out, so a re-run can't send duplicates.
  /// Nullable rather than a boolean so we keep the timestamp for debugging.
  reminderSentAt DateTime?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt

  @@unique([userId, scholarshipId, key])
  @@index([userId, isDone])
  /// Drives the reminder job: due soon, not done, not yet emailed.
  @@index([dueDate, isDone, reminderSentAt])
}
